# Backend database connection. Use the local port forwarded by SSH.
DB_HOST=127.0.0.1
DB_PORT=3307
DB_USER=ist_remote
DB_PASSWORD=replace-with-a-strong-password
DB_NAME=istbrasil

# SSH server access is configured outside the application.
SSH_USER=replace-with-ssh-user
SSH_HOST=replace-with-server-host
SSH_LOCAL_PORT=3307
SSH_REMOTE_DB_HOST=127.0.0.1
SSH_REMOTE_DB_PORT=3306