# Backend database connection. Use the local port forwarded by SSH.
DB_HOST=127.0.0.1
DB_PORT=3307
DB_USER=ist_remote
DB_PASSWORD=replace-with-a-strong-password
DB_NAME=istbrasil

# SMTP (dev: Locaweb email-ssl.com.br; prod: smtp-relay.gmail.com / MTA local)
SMTP_HOST=email-ssl.com.br
SMTP_PORT=587
SMTP_SECURE=false
SMTP_REJECT_UNAUTHORIZED=true
SMTP_USER=replace-with-smtp-user
SMTP_PASS=replace-with-smtp-password
MAIL_FROM_NAME=Cadastro IST (Confirmação de Email)
MAIL_FROM_ADDRESS=replace-with-from-address

# Login session cookie
COOKIE_NAME=ist_session
COOKIE_SECURE=false
COOKIE_HTTPONLY=true
COOKIE_SAMESITE=lax
COOKIE_MAXLIFETIME=86400
COOKIE_HTTP_HOST=
JWT_SECRET=replace-with-a-long-random-secret

# SSH server access is configured outside the application.
SSH_USER=replace-with-ssh-user
SSH_HOST=replace-with-server-host
SSH_LOCAL_PORT=3307
SSH_REMOTE_DB_HOST=127.0.0.1
SSH_REMOTE_DB_PORT=3306